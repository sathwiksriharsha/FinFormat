      </svg>
    </div>
  )}

  {key === 'cash-app' && (
    <div style="background-color: #00D632; width: 100%; height: 100%; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
      <span style="font-size: 16px; font-weight: 900; color: #FFFFFF; font-family: sans-serif;">$</span>
    </div>
  )}

  {key === 'wise' && (
    <div style="background-color: #163300; width: 100%; height: 100%; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M6 6L11 18H14L18 6H15L12.5 14L9 6H6Z" fill="#9FE870"/>
        <polygon points="12,6 18,6 15,11 9,11" fill="#9FE870"/>
      </svg>
    </div>
  )}

  {key === 'default' && (
    <div style="background-color: #0F172A; width: 100%; height: 100%; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="#FFFFFF">
        <path d="M12 2L3 9v13h18V9l-9-7zm0 3.8L18 10v9H6v-9l6-4.2z"/>
      </svg>
    </div>
  )}
</div>
