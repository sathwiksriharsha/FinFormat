  {key === 'square' && (
    <div style="background-color: #000000; width: 100%; height: 100%; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <rect x="3" y="3" width="18" height="18" rx="4" stroke="#FFFFFF" stroke-width="2.5"/>
        <rect x="8.5" y="8.5" width="7" height="7" rx="1.5" fill="#FFFFFF"/>
      </svg>
    </div>
  )}

  {key === 'shopify' && (
    <div style="background-color: #95BF47; width: 100%; height: 100%; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M6 7L4 21H20L18 7H6Z" fill="#FFFFFF"/>
        <path d="M8 7V5C8 3 9.8 1.5 12 1.5C14.2 1.5 16 3 16 5V7" stroke="#95BF47" stroke-width="2" stroke-linecap="round"/>
        <text x="9" y="16" font-size="8" font-weight="900" fill="#95BF47" font-family="sans-serif">S</text>
      </svg>
    </div>
  )}

  {key === 'venmo' && (
    <div style="background-color: #008CFF; width: 100%; height: 100%; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
