---
import { SITE } from '../config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="top-nav" role="banner">
  <div class="site-container" style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
    <!-- Brand Logo -->
    <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--color-ink); flex-shrink: 0;" aria-label="FinFormat Home">
      <svg width="30" height="30" viewBox="0 0 48 48" fill="none" aria-hidden="true" style="flex-shrink: 0;">
        <rect width="48" height="48" rx="12" fill="#000000"/>
        <rect x="10" y="12" width="28" height="5" rx="2.5" fill="#FFFFFF"/>
        <rect x="10" y="21" width="18" height="5" rx="2.5" fill="#DCEEB1"/>
        <rect x="10" y="30" width="24" height="5" rx="2.5" fill="#FFFFFF"/>
        <circle cx="34" cy="23.5" r="3.5" fill="#DCEEB1"/>
      </svg>
      <span style="font-size: 19px; font-weight: 700; letter-spacing: -0.4px;">FinFormat</span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav style="display: flex; align-items: center; gap: 26px;" class="desktop-nav" aria-label="Main Navigation">
      {SITE.nav.map(item => {
        const isActive = currentPath === item.href;
        return (
          <a 
            href={item.href} 
            style={`font-size: 15px; font-weight: ${isActive ? '600' : '480'}; color: var(--color-ink); text-decoration: none; transition: opacity 160ms; ${isActive ? 'text-decoration: underline; text-underline-offset: 6px;' : ''}`}
            class="nav-link"
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop Right Actions -->
    <div class="desktop-actions" style="display: flex; align-items: center; gap: 12px;">
      <a href="/security-privacy" class="badge-lime" style="font-size: 13px; font-weight: 600; padding: 7px 14px; text-decoration: none; border-radius: var(--rounded-pill); display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(0, 0, 0, 0.06);">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        100% Local. No Uploads.
      </a>
      <a href="/#workbench" class="button-primary" style="font-size: 14px; padding: 8px 18px; border-radius: var(--rounded-pill); gap: 6px;">
        <span>Convert Statement</span>
        <span style="font-size: 15px;">&rarr;</span>
      </a>
    </div>

    <!-- Mobile Header Actions & Menu Toggle -->
    <div class="mobile-actions" style="display: none; align-items: center; gap: 8px;">
      <a href="/#workbench" class="button-primary mobile-convert-cta" style="font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: var(--rounded-pill);">
        Convert
      </a>

      <button 
        id="mobileMenuToggle" 
        class="mobile-menu-btn" 
        aria-label="Open navigation menu" 
        aria-expanded="false" 
        aria-controls="mobileNavDrawer"
        type="button"
      >
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer & Backdrop -->
<div 
  id="mobileNavDrawer" 
  class="mobile-drawer" 
  role="dialog" 
  aria-modal="true" 
  aria-label="Mobile Navigation Menu"
  style="display: none;"
>
  <div class="mobile-drawer-inner">
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 18px 20px; border-bottom: 1px solid var(--color-hairline);">
      <a href="/" class="mobile-drawer-brand" style="display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--color-ink);">
        <svg width="26" height="26" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <rect width="48" height="48" rx="12" fill="#000000"/>
          <rect x="10" y="12" width="28" height="5" rx="2.5" fill="#FFFFFF"/>
          <rect x="10" y="21" width="18" height="5" rx="2.5" fill="#DCEEB1"/>
          <rect x="10" y="30" width="24" height="5" rx="2.5" fill="#FFFFFF"/>
          <circle cx="34" cy="23.5" r="3.5" fill="#DCEEB1"/>
        </svg>
        <span style="font-size: 18px; font-weight: 700;">FinFormat</span>
      </a>
      <button id="closeMobileDrawerBtn" type="button" class="drawer-close-btn" aria-label="Close navigation menu">
        ✕
      </button>
    </div>

    <!-- Mobile Nav Links -->
    <nav style="display: flex; flex-direction: column; padding: 12px 16px;" aria-label="Mobile Menu Navigation">
      {SITE.nav.map(item => {
        const isActive = currentPath === item.href;
        return (
          <a 
            href={item.href} 
            class={`mobile-drawer-link ${isActive ? 'active' : ''}`}
            aria-current={isActive ? 'page' : undefined}
          >
            <span>{item.label}</span>
            <span style="color: #94A3B8; font-size: 18px;">&rarr;</span>
          </a>
        );
      })}
    </nav>

    <!-- Drawer Footer Actions -->
    <div style="padding: 16px; margin-top: auto; border-top: 1px solid var(--color-hairline); display: flex; flex-direction: column; gap: 12px;">
      <a href="/security-privacy" class="badge-lime" style="padding: 10px 14px; font-size: 13px; text-decoration: none; justify-content: center;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        100% Client-Side Privacy Guarantee
      </a>

      <a href="/#workbench" class="button-primary mobile-drawer-cta" style="width: 100%; text-align: center; padding: 13px 20px; font-size: 15px;">
        Convert Statement Now
      </a>
    </div>
  </div>
</div>
<div id="mobileDrawerBackdrop" class="drawer-backdrop" aria-hidden="true" style="display: none;"></div>

<style>
  .nav-link:hover {
    opacity: 0.65;
  }

  /* Desktop vs Mobile Breakpoints */
  @media (min-width: 841px) {
    .mobile-drawer,
    .drawer-backdrop,
    .mobile-actions,
    .mobile-menu-btn {
      display: none !important;
    }
  }

  @media (max-width: 840px) {
    .desktop-nav, 
    .desktop-actions {
      display: none !important;
    }
    .mobile-actions {
      display: flex !important;
    }
    .mobile-menu-btn {
      display: flex !important;
    }
  }

  @media (max-width: 360px) {
    .mobile-convert-cta {
      display: none !important;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobileMenuToggle') as HTMLButtonElement | null;
  const drawer = document.getElementById('mobileNavDrawer') as HTMLElement | null;
  const backdrop = document.getElementById('mobileDrawerBackdrop') as HTMLElement | null;
  const closeBtn = document.getElementById('closeMobileDrawerBtn') as HTMLButtonElement | null;

  function openDrawer() {
    if (!drawer || !backdrop || !toggleBtn) return;
    drawer.style.display = 'block';
    backdrop.style.display = 'block';
    requestAnimationFrame(() => {
      drawer.classList.add('open');
      backdrop.classList.add('open');
      toggleBtn.classList.add('active');
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Close navigation menu');
      document.body.style.overflow = 'hidden';
    });
  }

  function closeDrawer() {
    if (!drawer || !backdrop || !toggleBtn) return;
    drawer.classList.remove('open');
    backdrop.classList.remove('open');
    toggleBtn.classList.remove('active');
    toggleBtn.setAttribute('aria-expanded', 'false');
    toggleBtn.setAttribute('aria-label', 'Open navigation menu');
    document.body.style.overflow = '';
    setTimeout(() => {
      if (!drawer.classList.contains('open')) {
        drawer.style.display = 'none';
        backdrop.style.display = 'none';
      }
    }, 280);
  }

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      if (drawer?.classList.contains('open')) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });
  }

  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (backdrop) backdrop.addEventListener('click', closeDrawer);

  // Close when clicking any nav link
  document.querySelectorAll('.mobile-drawer-link, .mobile-drawer-cta').forEach(link => {
    link.addEventListener('click', closeDrawer);
  });

  // Close on Escape key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('open')) {
      closeDrawer();
    }
  });

  // Automatically close and reset if resized to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth > 840 && drawer?.classList.contains('open')) {
      closeDrawer();
    }
  });
</script>
