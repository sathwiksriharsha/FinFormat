    .step-item,
    .progress-bar-pill {
      transition: none !important;
    }
  }
</style>

<script>
  import type { NormalizedTransaction, AccountMetadata } from '../utils/types';
  import { parseCSV, parseCSVToRows, exportToCSV, exportToQuickBooks3Col, exportToXeroCSV, exportToTSV } from '../utils/csvEngine';
  import { generateQBO } from '../utils/qboGenerator';
  import { parseOFX } from '../utils/ofxParser';
  import { generateIIF, parseIIF } from '../utils/iifEngine';
  import { generateQIF, parseQIF } from '../utils/qifEngine';
  import { parseMT940, parseCAMT053 } from '../utils/mt940CamtEngine';
  import { getContextAwareSample } from '../utils/sampleData';

  // Read config from DOM data attributes
  const workbench = document.getElementById('workbench') as HTMLElement | null;
  const presetSlug = workbench?.dataset.presetSlug || '';

  // Workflow State: 1 = Choose file, 2 = Review transactions, 3 = Export file
  let currentWorkflowStep: 1 | 2 | 3 = 1;

  // Client-Side Conversion Workspace Engine State
  let loadedTransactions: NormalizedTransaction[] = [];
  let loadedFiles: Array<{ name: string; text: () => Promise<string> }> = [];
  let sanitizedCount = 0;
  let parsedRawHeaders: string[] = [];

  // DOM Elements with explicit typing
  const dropZone = document.getElementById('dropZone') as HTMLElement | null;
  const fileInput = document.getElementById('fileInput') as HTMLInputElement | null;
  const loadSampleBtn = document.getElementById('loadSampleBtn') as HTMLButtonElement | null;
  const loadedFilesList = document.getElementById('loadedFilesList') as HTMLElement | null;
  const loadedFilesPills = document.getElementById('loadedFilesPills') as HTMLElement | null;
  const sourceFormatSelect = document.getElementById('sourceFormatSelect') as HTMLSelectElement | null;
  const targetFormatSelect = document.getElementById('targetFormatSelect') as HTMLSelectElement | null;
  const flipSignsToggle = document.getElementById('flipSignsToggle') as HTMLInputElement | null;
  const ol222Toggle = document.getElementById('ol222Toggle') as HTMLInputElement | null;
  const splitFeesToggle = document.getElementById('splitFeesToggle') as HTMLInputElement | null;
  const dedupToggle = document.getElementById('dedupToggle') as HTMLInputElement | null;
  const toggleSettingsBtn = document.getElementById('toggleSettingsBtn') as HTMLButtonElement | null;
  const accountSettingsPanel = document.getElementById('accountSettingsPanel') as HTMLElement | null;
  const accountTypeSelect = document.getElementById('accountTypeSelect') as HTMLSelectElement | null;
  const intuBidInput = document.getElementById('intuBidInput') as HTMLSelectElement | null;
  const accountNumInput = document.getElementById('accountNumInput') as HTMLInputElement | null;
  const offsetAccountInput = document.getElementById('offsetAccountInput') as HTMLInputElement | null;
  
  // Progress Bar Elements (Image 2)
  const conversionProgressContainer = document.getElementById('conversionProgressContainer') as HTMLElement | null;
  const progressText = document.getElementById('progressText') as HTMLElement | null;
  const progressPercent = document.getElementById('progressPercent') as HTMLElement | null;
  const progressPill = document.getElementById('progressPill') as HTMLElement | null;

  // Stepper Elements
  const stepIndicator1 = document.getElementById('stepIndicator1') as HTMLButtonElement | null;
  const stepIndicator2 = document.getElementById('stepIndicator2') as HTMLButtonElement | null;
  const stepIndicator3 = document.getElementById('stepIndicator3') as HTMLButtonElement | null;

  // "Check Your Transactions" Elements (Image 1)
  const checkTransactionsCard = document.getElementById('checkTransactionsCard') as HTMLElement | null;
  const checkTransactionsNotice = document.getElementById('checkTransactionsNotice') as HTMLElement | null;
  const colMapDate = document.getElementById('colMapDate') as HTMLSelectElement | null;
  const colMapDateFormat = document.getElementById('colMapDateFormat') as HTMLSelectElement | null;
  const colMapDesc = document.getElementById('colMapDesc') as HTMLSelectElement | null;
  const colMapCheckNum = document.getElementById('colMapCheckNum') as HTMLSelectElement | null;
  const colMapAmountType = document.getElementById('colMapAmountType') as HTMLSelectElement | null;
  const colMapDebit = document.getElementById('colMapDebit') as HTMLSelectElement | null;
  const colMapCredit = document.getElementById('colMapCredit') as HTMLSelectElement | null;
  const btnBackToStep1 = document.getElementById('btnBackToStep1') as HTMLButtonElement | null;
  const btnConfirmConvert = document.getElementById('btnConfirmConvert') as HTMLButtonElement | null;
  const debitFieldContainer = document.getElementById('debitFieldContainer') as HTMLElement | null;
  const creditFieldContainer = document.getElementById('creditFieldContainer') as HTMLElement | null;

  // Register & Export Elements
  const metricsBar = document.getElementById('metricsBar') as HTMLElement | null;
  const metricTotalRows = document.getElementById('metricTotalRows') as HTMLElement | null;
  const metricCredits = document.getElementById('metricCredits') as HTMLElement | null;
  const metricDebits = document.getElementById('metricDebits') as HTMLElement | null;
  const metricNet = document.getElementById('metricNet') as HTMLElement | null;
  const repairBadgesContainer = document.getElementById('repairBadgesContainer') as HTMLElement | null;
  const tableContainer = document.getElementById('tableContainer') as HTMLElement | null;
  const transactionTableBody = document.getElementById('transactionTableBody') as HTMLTableSectionElement | null;
  const selectAllRows = document.getElementById('selectAllRows') as HTMLInputElement | null;
  const rawPreviewDrawer = document.getElementById('rawPreviewDrawer') as HTMLElement | null;
  const rawPreviewContent = document.getElementById('rawPreviewContent') as HTMLPreElement | null;
  const toggleRawDrawerBtn = document.getElementById('toggleRawDrawerBtn') as HTMLButtonElement | null;
  const copyRawBtn = document.getElementById('copyRawBtn') as HTMLButtonElement | null;
  const downloadActionRow = document.getElementById('downloadActionRow') as HTMLElement | null;
  const downloadPrimaryBtn = document.getElementById('downloadPrimaryBtn') as HTMLButtonElement | null;
  const copyTsvBtn = document.getElementById('copyTsvBtn') as HTMLButtonElement | null;

  // Workflow State Manager
  function setWorkflowStep(step: 1 | 2 | 3) {
    currentWorkflowStep = step;

    [stepIndicator1, stepIndicator2, stepIndicator3].forEach((indicator, idx) => {
      if (!indicator) return;
      const indicatorStep = (idx + 1) as 1 | 2 | 3;
      indicator.classList.remove('active', 'completed');
      if (indicatorStep === currentWorkflowStep) {
        indicator.classList.add('active');
      } else if (indicatorStep < currentWorkflowStep) {
        indicator.classList.add('completed');
      }
    });

    if (step === 1) {
      if (checkTransactionsCard) checkTransactionsCard.style.display = 'none';
      if (dropZone) dropZone.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else if (step === 2) {
      if (checkTransactionsCard && loadedTransactions.length > 0) {
        checkTransactionsCard.style.display = 'block';
        checkTransactionsCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    } else if (step === 3) {
      if (downloadActionRow && loadedTransactions.length > 0) {
        downloadActionRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }
  }

  // Stepper Click Listeners
  if (stepIndicator1) stepIndicator1.addEventListener('click', () => setWorkflowStep(1));
  if (stepIndicator2) stepIndicator2.addEventListener('click', () => {
    if (loadedTransactions.length > 0) setWorkflowStep(2);
  });
  if (stepIndicator3) stepIndicator3.addEventListener('click', () => {
    if (loadedTransactions.length > 0) setWorkflowStep(3);
  });

  // Toggle Settings
  if (toggleSettingsBtn && accountSettingsPanel) {
    toggleSettingsBtn.addEventListener('click', () => {
      accountSettingsPanel.style.display = accountSettingsPanel.style.display === 'none' ? 'grid' : 'none';
    });
  }

  // Toggle Raw Drawer
  if (toggleRawDrawerBtn && rawPreviewDrawer) {
    toggleRawDrawerBtn.addEventListener('click', () => {
      rawPreviewDrawer.style.display = rawPreviewDrawer.style.display === 'none' ? 'block' : 'none';
      if (rawPreviewDrawer.style.display === 'block') {
        updateRawPreview();
      }
    });
  }

  // DropZone Drag & Drop
  if (dropZone && fileInput) {
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    dropZone.addEventListener('dragover', (e: DragEvent) => {
      e.preventDefault();
      dropZone.style.borderColor = '#0F172A';
      dropZone.style.backgroundColor = '#F1F5F9';
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.style.borderColor = '#CBD5E1';
      dropZone.style.backgroundColor = '#FAFBFD';
    });
    dropZone.addEventListener('drop', (e: DragEvent) => {
      e.preventDefault();
      dropZone.style.borderColor = '#CBD5E1';
      dropZone.style.backgroundColor = '#FAFBFD';
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        handleFiles(Array.from(e.dataTransfer.files));
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFiles(Array.from(fileInput.files));
      }
    });
  }

  // Re-run conversion if options change
  const toggleElements: (HTMLElement | null)[] = [
    sourceFormatSelect, flipSignsToggle, ol222Toggle, splitFeesToggle, dedupToggle,
    targetFormatSelect, accountTypeSelect, intuBidInput, accountNumInput, offsetAccountInput
  ];

  toggleElements.forEach(el => {
    if (el) {
      el.addEventListener('change', () => {
        if (loadedFiles.length > 0) {
          processAllFiles();
        }
      });
    }
  });

  // Load Context-Aware Sample Statement
  if (loadSampleBtn) {
    loadSampleBtn.addEventListener('click', async (e: MouseEvent) => {
      e.stopPropagation();
      const sample = getContextAwareSample(presetSlug);
      handleFiles([{ name: sample.name, text: async () => sample.content }]);
    });
  }

  // Back and Convert button handlers for Image 1 Card
  if (btnBackToStep1) {
    btnBackToStep1.addEventListener('click', () => {
      setWorkflowStep(1);
    });
  }

  if (btnConfirmConvert) {
    btnConfirmConvert.addEventListener('click', () => {
      setWorkflowStep(3);
    });
  }

  // Amount column type toggler
  if (colMapAmountType) {
    colMapAmountType.addEventListener('change', () => {
      const isSeparate = colMapAmountType.value === 'separate';
      if (debitFieldContainer) debitFieldContainer.style.display = isSeparate ? 'flex' : 'none';
      if (creditFieldContainer) creditFieldContainer.style.display = isSeparate ? 'flex' : 'none';
    });
  }

  if (colMapDateFormat) {
    colMapDateFormat.addEventListener('change', () => {
      if (loadedFiles.length > 0) processAllFiles();
    });
  }

  // Animated Conversion Progress Indicator (Image 2)
  function runConversionProgress(onComplete: () => void) {
    if (!conversionProgressContainer) {
      onComplete();
      return;
    }

    conversionProgressContainer.style.display = 'flex';
    if (dropZone) dropZone.style.opacity = '0.6';

    const stages = [
      { pct: 18, text: 'Reading statement file...' },
      { pct: 46, text: 'Parsing statement columns...' },
      { pct: 72, text: 'Validating records & signs...' },
      { pct: 93, text: 'Validating records...' },
      { pct: 100, text: 'Transactions ready!' }
    ];

    let stepIdx = 0;
    function nextStage() {
      if (stepIdx < stages.length) {
        const stage = stages[stepIdx];
        if (progressText) progressText.textContent = stage.text;
        if (progressPercent) progressPercent.textContent = `${stage.pct}%`;
        if (progressPill) progressPill.setAttribute('data-pct', stage.pct.toString());
        stepIdx++;
        setTimeout(nextStage, 80);
      } else {
        setTimeout(() => {
          if (conversionProgressContainer) conversionProgressContainer.style.display = 'none';
          if (dropZone) dropZone.style.opacity = '1';
          onComplete();
        }, 120);
      }
    }
    nextStage();
  }

  async function handleFiles(files: Array<{ name: string; text: () => Promise<string> }>) {
    loadedFiles = files;
    updateFilePills();
    
    // Trigger animated conversion progress bar (Image 2 Archetype)
    runConversionProgress(async () => {
      await processAllFiles();
      setWorkflowStep(2);
    });
  }

  function updateFilePills() {
    if (!loadedFilesList || !loadedFilesPills) return;
    loadedFilesList.style.display = 'flex';
    loadedFilesPills.innerHTML = '';
    loadedFiles.forEach(f => {
      const pill = document.createElement('span');
      pill.className = 'badge-navy';
      pill.style.fontSize = '12px';
      pill.textContent = f.name;
      loadedFilesPills.appendChild(pill);
    });
  }

  async function processAllFiles() {
    sanitizedCount = 0;
    let allTx: NormalizedTransaction[] = [];

    const flipSigns = flipSignsToggle?.checked || false;
    const splitFees = splitFeesToggle?.checked || false;
    const dedup = dedupToggle?.checked || false;
    const acctType = (accountTypeSelect?.value || 'CHECKING') as AccountMetadata['accountType'];
    const bankId = intuBidInput?.value || '3000';

    for (const f of loadedFiles) {
      const content = await f.text();
      const fname = f.name.toLowerCase();

      let result;
      if (fname.endsWith('.qbo') || fname.endsWith('.ofx') || fname.endsWith('.qfx') || content.includes('<OFX>')) {
        result = parseOFX(content);
        if (content.includes('&') || content.length > 0) {
          const matchAmp = (content.match(/<NAME>[^<]*&[^<]*/g) || []).length;
          sanitizedCount += matchAmp;
        }
      } else if (fname.endsWith('.iif') || content.includes('!TRNS')) {
        result = parseIIF(content);
      } else if (fname.endsWith('.qif') || content.includes('!Type:')) {
        result = parseQIF(content);
      } else if (fname.endsWith('.mt940') || fname.endsWith('.sta') || content.includes(':61:')) {
        result = parseMT940(content);
      } else if (fname.endsWith('.xml') && content.includes('<Ntry>')) {
        result = parseCAMT053(content);
      } else {
        // Parse CSV & inspect raw rows for column mapping
        const rawRows = parseCSVToRows(content);
        if (rawRows.length > 0) {
          parsedRawHeaders = rawRows[0];
          populateColumnMappingOptions(parsedRawHeaders);
        }

        result = parseCSV(content, {
          flipSigns,
          splitFees,
          deduplicate: dedup,
          defaultAccountType: acctType,
          bankId
        });
      }

      if (result && result.transactions) {
        allTx.push(...result.transactions);
      }
    }

    // Sort chronologically
    allTx.sort((a, b) => a.date.localeCompare(b.date));

    // Deduplication across batch if toggled
    if (dedup) {
      const seen = new Set<string>();
      const deduped: NormalizedTransaction[] = [];
      for (const t of allTx) {
        const key = t.fitId ? `fit_${t.fitId}` : `${t.date}_${t.amount}_${t.payee.toLowerCase().slice(0, 20)}`;
        if (!seen.has(key)) {
          seen.add(key);
          deduped.push(t);
        }
      }
      allTx = deduped;
    }

    loadedTransactions = allTx;
    renderUI();
  }

  function populateColumnMappingOptions(headers: string[]) {
    const selects = [colMapDate, colMapDesc, colMapCheckNum, colMapDebit, colMapCredit];
    selects.forEach(sel => {
      if (!sel) return;
      sel.innerHTML = '';
      const emptyOpt = document.createElement('option');
      emptyOpt.value = '';
      emptyOpt.textContent = '(None / Auto)';
      sel.appendChild(emptyOpt);

      headers.forEach((h, idx) => {
        const opt = document.createElement('option');
        opt.value = idx.toString();
        opt.textContent = `${h} (Col ${idx + 1})`;
        sel.appendChild(opt);
      });
    });

    // Smart auto-select
    headers.forEach((h, idx) => {
      const lower = h.toLowerCase();
      if (/date|posted|time/.test(lower) && colMapDate) colMapDate.value = idx.toString();
      if (/desc|payee|name|merchant/.test(lower) && colMapDesc) colMapDesc.value = idx.toString();
      if (/check|chk/.test(lower) && colMapCheckNum) colMapCheckNum.value = idx.toString();
      if (/debit|withdrawal|outflow/.test(lower) && colMapDebit) colMapDebit.value = idx.toString();
      if (/credit|deposit|inflow/.test(lower) && colMapCredit) colMapCredit.value = idx.toString();
    });
  }

  function renderUI() {
    if (!metricsBar || !tableContainer || !downloadActionRow) return;

    if (loadedTransactions.length === 0) {
      if (checkTransactionsCard) checkTransactionsCard.style.display = 'none';
      metricsBar.style.display = 'none';
      tableContainer.style.display = 'none';
      downloadActionRow.style.display = 'none';
      return;
    }

    if (checkTransactionsCard) {
      checkTransactionsCard.style.display = 'block';
      if (checkTransactionsNotice) {
        checkTransactionsNotice.textContent = `✓ We've read ${loadedTransactions.length} transactions from your file. Check the columns below.`;
      }
    }

    metricsBar.style.display = 'flex';
    tableContainer.style.display = 'block';
    downloadActionRow.style.display = 'flex';

    // Compute Metrics
    let credits = 0;
    let debits = 0;
    let net = 0;

    loadedTransactions.forEach(t => {
      if (t.selected !== false) {
        if (t.amount > 0) credits += t.amount;
        else debits += Math.abs(t.amount);
        net += t.amount;
      }
    });

    if (metricTotalRows) metricTotalRows.textContent = loadedTransactions.length.toString();
    if (metricCredits) metricCredits.textContent = `+$${credits.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    if (metricDebits) metricDebits.textContent = `-$${debits.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    if (metricNet) {
      metricNet.textContent = `${net >= 0 ? '+' : '-'}$${Math.abs(net).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      metricNet.style.color = net >= 0 ? '#16A34A' : '#DC2626';
    }

    // Repair Badges
    if (repairBadgesContainer) {
      repairBadgesContainer.innerHTML = '';
      if (ol222Toggle?.checked) {
        const badge = document.createElement('span');
        badge.className = 'badge-lime';
        badge.textContent = '🛡️ OL-222 SANITIZED';
        repairBadgesContainer.appendChild(badge);
      }
      if (flipSignsToggle?.checked) {
        const badge = document.createElement('span');
        badge.className = 'badge-lilac';
        badge.textContent = '⇄ CHARGE SIGNS INVERTED';
        repairBadgesContainer.appendChild(badge);
      }
      if (dedupToggle?.checked) {
        const badge = document.createElement('span');
        badge.className = 'badge-navy';
        badge.textContent = '🧹 FITID DEDUPLICATED';
        repairBadgesContainer.appendChild(badge);
      }
    }

    // Render Table Rows
    if (transactionTableBody) {
      transactionTableBody.innerHTML = '';
      loadedTransactions.forEach((t, idx) => {
        const tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid #E2E8F0';
        if (!t.selected) tr.style.opacity = '0.4';

        tr.innerHTML = `
          <td style="padding: 12px 14px; text-align: center; width: 44px;"><input type="checkbox" data-idx="${idx}" class="row-select" style="width: 18px; height: 18px; cursor: pointer;" ${t.selected !== false ? 'checked' : ''} aria-label="Select row ${idx + 1}" /></td>
          <td style="padding: 12px 14px; font-family: var(--font-mono); font-size: 13px; white-space: nowrap;">${t.date}</td>
          <td style="padding: 12px 14px; min-width: 150px;" contenteditable="true" data-field="payee" data-idx="${idx}">${escapeHTML(t.payee)}</td>
          <td style="padding: 12px 14px; text-align: right; font-weight: 600; font-family: var(--font-mono); white-space: nowrap; color: ${t.amount < 0 ? '#DC2626' : '#16A34A'};">
            ${t.amount < 0 ? '-' : '+'}$${Math.abs(t.amount).toFixed(2)}
          </td>
          <td style="padding: 12px 14px; min-width: 140px;" contenteditable="true" data-field="memo" data-idx="${idx}">${escapeHTML(t.memo || '')}</td>
          <td style="padding: 12px 14px; font-family: var(--font-mono); font-size: 12px;">${escapeHTML(t.checkNum || '')}</td>
          <td style="padding: 12px 14px; font-family: var(--font-mono); font-size: 11px; color: #64748B;">${escapeHTML(t.fitId || '')}</td>
        `;
        transactionTableBody.appendChild(tr);
      });

      // Attach Cell Editing & Row Selection
      transactionTableBody.querySelectorAll('.row-select').forEach(cb => {
        cb.addEventListener('change', (e: Event) => {
          const target = e.target as HTMLInputElement;
          const idx = parseInt(target.getAttribute('data-idx') || '0', 10);
          loadedTransactions[idx].selected = target.checked;
          renderUI();
        });
      });

      transactionTableBody.querySelectorAll('[contenteditable="true"]').forEach(cell => {
        cell.addEventListener('blur', (e: Event) => {
          const target = e.target as HTMLElement;
          const idx = parseInt(target.getAttribute('data-idx') || '0', 10);
          const field = target.getAttribute('data-field') as keyof NormalizedTransaction;
          if (field) {
            (loadedTransactions[idx] as any)[field] = target.textContent?.trim() || '';
          }
          updateRawPreview();
        });
      });
    }

    // Update CTA text
    const target = targetFormatSelect?.value || 'QBO';
    if (downloadPrimaryBtn) {
      downloadPrimaryBtn.textContent = `📥 Download Ready .${target.toLowerCase()} (${loadedTransactions.filter(t => t.selected !== false).length} Rows)`;
    }

    if (rawPreviewDrawer && rawPreviewDrawer.style.display === 'block') {
      updateRawPreview();
    }
  }

  if (selectAllRows) {
    selectAllRows.addEventListener('change', () => {
      const isChecked = selectAllRows.checked;
      loadedTransactions.forEach(t => t.selected = isChecked);
      renderUI();
    });
  }

  function generateOutputContent(): { text: string; ext: string; mime: string } {
    const activeTx = loadedTransactions.filter(t => t.selected !== false);
    const target = targetFormatSelect?.value || 'QBO';

    const accountMeta: AccountMetadata = {
      accountType: (accountTypeSelect?.value || 'CHECKING') as AccountMetadata['accountType'],
      accountNumber: accountNumInput?.value || '4492',
      routingNumber: '3000',
      bankId: intuBidInput?.value || '3000',
      bankName: 'FinFormat Account',
      currency: 'USD',
      iifOffsetAccount: offsetAccountInput?.value || 'Ask My Accountant'
    };

    if (target === 'QBO' || target === 'OFX' || target === 'QFX') {
      return {
        text: generateQBO(activeTx, accountMeta, { targetFormat: target as any, ol222SafeMode: ol222Toggle?.checked }),
        ext: target.toLowerCase(),
        mime: 'application/x-ofx'
      };
    } else if (target === 'IIF') {
      return {
        text: generateIIF(activeTx, accountMeta),
        ext: 'iif',
        mime: 'text/plain'
      };
    } else if (target === 'QIF') {
      return {
        text: generateQIF(activeTx, accountMeta),
        ext: 'qif',
        mime: 'text/plain'
      };
    } else if (target === 'QB_CSV') {
      return {
        text: exportToQuickBooks3Col(activeTx),
        ext: 'csv',
        mime: 'text/csv'
      };
    } else if (target === 'XERO_CSV') {
      return {
        text: exportToXeroCSV(activeTx),
        ext: 'csv',
        mime: 'text/csv'
      };
    } else {
      return {
        text: exportToCSV(activeTx),
        ext: 'csv',
        mime: 'text/csv'
      };
    }
  }

  function updateRawPreview() {
    if (!rawPreviewContent) return;
    const output = generateOutputContent();
    rawPreviewContent.textContent = output.text.slice(0, 3000) + (output.text.length > 3000 ? '\n\n... [Remaining output truncated for preview]' : '');
  }

  // Download Action
  if (downloadPrimaryBtn) {
    downloadPrimaryBtn.addEventListener('click', () => {
      const output = generateOutputContent();
      const target = targetFormatSelect?.value || 'qbo';
      const blob = new Blob([output.text], { type: output.mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `finformat_${target.toLowerCase()}_export.${output.ext}`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  // TSV Copy for Excel
  if (copyTsvBtn) {
    copyTsvBtn.addEventListener('click', () => {
      const tsv = exportToTSV(loadedTransactions.filter(t => t.selected !== false));
      navigator.clipboard.writeText(tsv).then(() => {
        const orig = copyTsvBtn.textContent;
        copyTsvBtn.textContent = '✓ Copied to Clipboard!';
        setTimeout(() => copyTsvBtn.textContent = orig, 2000);
      });
    });
  }

  if (copyRawBtn) {
    copyRawBtn.addEventListener('click', () => {
      const output = generateOutputContent();
      navigator.clipboard.writeText(output.text).then(() => {
        copyRawBtn.textContent = '✓ Copied!';
        setTimeout(() => copyRawBtn.textContent = 'Copy Code', 2000);
      });
    });
  }

  function escapeHTML(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
</script>
