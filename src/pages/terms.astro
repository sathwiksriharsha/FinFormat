---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Service & Disclaimers — FinFormat"
  description="Terms of service and non-affiliation disclaimers for the FinFormat financial converter utility."
  canonicalPath="/terms"
>
  <div class="site-container" style="padding-top: clamp(40px, 5vw, 64px); padding-bottom: 72px;">
    
    <section style="margin-bottom: 32px;">
      <span class="badge-lime" style="margin-bottom: 12px; display: inline-flex;">LEGAL & TERMS</span>
      <h1 class="display-lg" style="max-width: 900px; margin-bottom: 16px;">
        Terms of Service
      </h1>
      <p class="body-lg" style="max-width: 780px; color: #404040;">
        By accessing or using FinFormat, you agree to the following terms and acknowledge our non-affiliation disclaimers.
      </p>
    </section>

    <div class="bezel-tray">
      <div class="bezel-core" style="display: flex; flex-direction: column; gap: 24px;">
        <div>
          <h2 class="card-title" style="margin-bottom: 8px;">1. Trademark & Non-Affiliation Disclaimer</h2>
          <p class="body" style="color: #404040;">
            FinFormat is an independent software utility. FinFormat is not affiliated with, endorsed by, sponsored by, or in any way associated with Intuit Inc., QuickBooks®, Quicken®, Xero Limited, Microsoft Corporation, or any financial institution (including JPMorgan Chase, Bank of America, Wells Fargo, American Express, or Citibank) referenced on this website. All product names, logos, and brands are property of their respective owners.
          </p>
        </div>

        <div>
          <h2 class="card-title" style="margin-bottom: 8px;">2. "As-Is" Software Provision</h2>
          <p class="body" style="color: #404040;">
            FinFormat is provided free of charge on an "AS IS" and "AS AVAILABLE" basis without warranties of any kind, whether express or implied. Users are solely responsible for reviewing and verifying the mathematical and categorical accuracy of converted ledger files prior to importing them into accounting registers.
          </p>
        </div>

        <div>
          <h2 class="card-title" style="margin-bottom: 8px;">3. No Professional Accounting Advice</h2>
          <p class="body" style="color: #404040;">
            The conversion and formatting utilities provided by FinFormat do not constitute certified accounting, financial, legal, or tax advice. For specific questions regarding corporate bookkeeping, tax filings, or chart of accounts reconciliation, please consult a licensed Certified Public Accountant (CPA) or professional bookkeeper.
          </p>
        </div>
      </div>
    </div>

  </div>
</BaseLayout>
