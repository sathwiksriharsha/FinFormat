---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConverterWorkspace from '../components/ConverterWorkspace.astro';
import BankLogo from '../components/BankLogo.astro';

const faqs = [
  {
    question: 'How does FinFormat ensure 100% privacy for bank statements?',
    answer: 'Unlike web converters that upload your bank statements to remote cloud servers, FinFormat runs entirely client-side using JavaScript in your browser tab. Your files, account numbers, and transaction balances never leave your computer.'
  },
  {
    question: 'How do I bypass the QuickBooks Desktop Web Connect sunset?',
    answer: 'When Intuit discontinues an older version of QuickBooks Desktop (2020–2023), Web Connect .QBO imports are disabled. Converting your bank statements to balanced .IIF format allows you to import transactions indefinitely without paying for a subscription.'
  },
  {
    question: 'What causes QuickBooks Error OL-222 and how does FinFormat fix it?',
    answer: 'QuickBooks Error OL-222 occurs when a .QBO file contains unescaped ampersands (&), illegal SGML characters (< > : /), or payee names exceeding 32 characters. FinFormat automatically sanitizes all illegal characters and truncates payee names while moving overflow descriptions into the memo field.'
  },
  {
    question: 'Why do American Express charges import as deposits, and how do I fix it?',
    answer: 'American Express exports charges as positive numbers. In accounting, charges are outflows (negative cash). FinFormat features a 1-click Credit Card Sign Flipper that inverts charges into negative numbers so they import into bank feeds correctly.'
  },
  {
    question: 'Can I batch merge multiple monthly bank statements into one file?',
    answer: 'Yes. Drop multiple CSV, QBO, or OFX files into the workbench simultaneously. FinFormat combines them chronologically, deduplicates repeating transactions using unique FITID hashes, and outputs a single unified statement.'
  }
];
---

<BaseLayout 
  title="FinFormat — Financial File Converters That Just Work"
  description="Convert, repair, and prepare bank statements for QuickBooks, Quicken, Excel, Xero and more — instantly in your browser. Fast, private, and free."
  canonicalPath="/"
  faqs={faqs}
>
  <div class="site-container" style="padding-top: clamp(36px, 5vw, 64px); padding-bottom: 72px;">
    
    <!-- Hero Section (Matching Image 1 & 2 Design System) -->
    <section class="hero-editorial-grid">
      <!-- Left Column: Copy, Search & Filters -->
      <div class="hero-copy-col">
        <div class="eyebrow" style="color: #64748B; margin-bottom: 12px; font-weight: 600; letter-spacing: 1px;">
          TOOLS &bull; 60+ CONVERTERS &amp; UTILITIES
        </div>
        
        <h1 class="display-serif" style="margin-bottom: 16px;">
          Financial file converters that just work.
        </h1>
        
        <p class="body-lg" style="color: #475569; max-width: 600px; margin-bottom: 28px; line-height: 1.5;">
          Convert, repair, and prepare bank statements for QuickBooks, Quicken, Excel, Xero and more &mdash; instantly in your browser. Fast, private, and free.
        </p>

        <!-- Interactive Search Bar -->
        <div class="search-bar-container" style="margin-bottom: 20px;">
          <div class="search-input-wrapper">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input 
              type="text" 
              id="heroToolsSearch" 
              class="hero-search-input" 
              placeholder='Search converters, e.g. "CSV to QBO", "OFX to CSV", "Stripe"...' 
              aria-label="Search financial converters and utilities"
            />
            <button type="button" id="searchSubmitBtn" class="search-arrow-btn" aria-label="Search tools">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
        </div>

        <!-- Filter Pills Row -->
        <div class="filter-pills-row" style="margin-bottom: 28px;">
          <button type="button" class="filter-pill active" data-category="all">All (60+)</button>
          <button type="button" class="filter-pill" data-category="converters">Format Converters</button>
          <button type="button" class="filter-pill" data-category="repair">QuickBooks Repair</button>
          <button type="button" class="filter-pill" data-category="banks">Bank Presets</button>
          <button type="button" class="filter-pill" data-category="excel">Excel &amp; CSV</button>
          <button type="button" class="filter-pill" data-category="popular">Popular</button>
