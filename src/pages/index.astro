            <div>
              <div style="font-size: 13.5px; font-weight: 700; color: #0F172A; line-height: 1.2;">100% Private</div>
              <div style="font-size: 12px; color: #64748B;">In your browser</div>
            </div>
          </div>

          <div class="trust-badge-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: #0F172A; flex-shrink: 0;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <div>
