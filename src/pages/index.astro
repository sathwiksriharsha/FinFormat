<script>
  // Client-side Reactive Search & Filter Logic
  const searchInput = document.getElementById('heroToolsSearch') as HTMLInputElement | null;
  const filterPills = document.querySelectorAll('.filter-pill');
  let activeCategory = 'all';
  let searchQuery = '';

  function applyFilters() {
    const catalogSections = document.querySelectorAll('.catalog-section') as NodeListOf<HTMLElement>;
    let totalVisible = 0;

    catalogSections.forEach(sec => {
      const items = sec.querySelectorAll('.tool-item') as NodeListOf<HTMLElement>;
      let secVisible = 0;

      items.forEach(item => {
        const itemCategories = (item.dataset.category || '').toLowerCase();
        const itemSearch = (item.dataset.search || '').toLowerCase();
        const itemText = item.innerText.toLowerCase();

        const matchesCategory = (activeCategory === 'all') || itemCategories.includes(activeCategory);
        const matchesSearch = !searchQuery || itemSearch.includes(searchQuery) || itemText.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          item.style.display = '';
          secVisible++;
          totalVisible++;
        } else {
          item.style.display = 'none';
        }
      });

      // Show section only if it has visible items
      if (secVisible > 0) {
        sec.style.display = 'block';
      } else {
        sec.style.display = 'none';
      }
    });

    // Also toggle featured bento card if searching or filtering non-converter category
    const featuredBento = document.querySelector('.featured-bento-section') as HTMLElement | null;
    if (featuredBento) {
      if (activeCategory === 'repair' || activeCategory === 'banks' || (searchQuery && !searchQuery.includes('csv') && !searchQuery.includes('qbo'))) {
        featuredBento.style.display = 'none';
      } else {
        featuredBento.style.display = 'block';
      }
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilters();
    });
  }

  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeCategory = pill.getAttribute('data-category') || 'all';

      applyFilters();

      // Smooth scroll directly to corresponding section
      if (activeCategory === 'converters') {
        document.getElementById('converters')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else if (activeCategory === 'repair') {
        document.getElementById('repair')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else if (activeCategory === 'banks') {
        document.getElementById('banks')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>
